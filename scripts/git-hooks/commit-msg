#!/usr/bin/env bash
# Temper hard rule: NO commit may carry a Claude attribution line — ever, no matter what.
# This commit-msg hook strips any "Co-Authored-By: Claude ..." trailer and any
# "Generated with ... Claude ..." line (including the 🤖 form) from every commit message.
#
# Install:  ln -sf ../../scripts/git-hooks/commit-msg .git/hooks/commit-msg
#       or: cp scripts/git-hooks/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg
set -euo pipefail
msg_file="$1"
tmp="$(mktemp)"
grep -viE 'co-authored-by:[[:space:]]*claude|generated with .*claude' "$msg_file" > "$tmp" || true
# Drop a trailing blank line left behind by stripping a trailer.
awk 'NF{blank=0} !NF{blank++} blank<2' "$tmp" > "$msg_file"
rm -f "$tmp"
