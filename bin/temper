#!/usr/bin/env python3
"""temper — anti-bluffing harness CLI.

  temper init [project]              wire a repo: commands, skills, hooks, .temper/, config block
  temper init [project] --dry-run    just detect verify commands and print the ## Temper block
  temper capture --task ID -- CMD    run CMD and record a signed evidence receipt for a task

`project` defaults to the current directory. Idempotent. Wires hooks into a project's
.claude/settings.local.json (personal, gitignored), never the shared settings.json. The engine
lives in this temper repo and is referenced in place (nothing is copied/installed system-wide);
a remote updater (`temper sync`, build-rite-style) is deferred.
"""

from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path

TEMPER_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(TEMPER_ROOT))
from lib import claude_md, detect  # noqa: E402

EVIDENCE_HOOK = f"python3 {TEMPER_ROOT}/hooks/evidence_gate.py"
INTEGRITY_HOOK = f"python3 {TEMPER_ROOT}/hooks/session_integrity.py"


def _say(msg: str) -> None:
    print(f"  {msg}")


def _link(src: Path, dst: Path) -> None:
    dst.parent.mkdir(parents=True, exist_ok=True)
    if dst.is_symlink() or dst.exists():
        if dst.is_symlink() and dst.resolve() == src.resolve():
            return
        dst.unlink()
    dst.symlink_to(src)
    _say(f"linked {dst.name} -> {src}")


def _command_present(settings: dict, command: str) -> bool:
    for event in settings.get("hooks", {}).values():
        for group in event:
            for h in group.get("hooks", []):
                if h.get("command") == command:
                    return True
    return False


def _add_hook(settings: dict, event: str, command: str, matcher: str | None) -> bool:
    if _command_present(settings, command):
        return False
    group = {"hooks": [{"type": "command", "command": command}]}
    if matcher is not None:
        group = {"matcher": matcher, **group}
    settings.setdefault("hooks", {}).setdefault(event, []).append(group)
    return True


def _remove_hook(settings: dict, command: str) -> bool:
    """Drop every hook entry whose command matches, pruning emptied groups/events."""
    changed = False
    hooks = settings.get("hooks", {})
    for event in list(hooks.keys()):
        new_groups = []
        for group in hooks[event]:
            entries = group.get("hooks", [])
            kept = [h for h in entries if h.get("command") != command]
            if len(kept) != len(entries):
                changed = True
            if kept:
                new_groups.append({**group, "hooks": kept})
        if new_groups:
            hooks[event] = new_groups
        else:
            del hooks[event]
    if changed and not hooks:
        settings.pop("hooks", None)
    return changed


def _load_settings(path: Path) -> dict | None:
    """Parsed settings, {} if absent, or None if present-but-invalid (caller skips)."""
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError:
        return None


def wire_hooks(project: Path) -> None:
    # Temper's hooks reference the engine by an absolute, machine-specific path, so they are
    # personal config — they go in .claude/settings.local.json (gitignored, higher precedence
    # than the shared settings.json), never the shared, committed settings.json. This mirrors
    # how the config block goes to CLAUDE.local.md, not CLAUDE.md.
    cdir = project / ".claude"
    local_path, shared_path = cdir / "settings.local.json", cdir / "settings.json"

    local = _load_settings(local_path)
    if local is None:
        _say(f"WARNING: {local_path} is not valid JSON; leaving it untouched")
        return
    changed = _add_hook(local, "PreToolUse", EVIDENCE_HOOK, "Edit|Write|MultiEdit")
    changed |= _add_hook(local, "Stop", INTEGRITY_HOOK, None)
    if changed:
        cdir.mkdir(parents=True, exist_ok=True)
        local_path.write_text(json.dumps(local, indent=2) + "\n")
        _say("wired evidence_gate (PreToolUse) + session_integrity (Stop) into settings.local.json")
    else:
        _say("hooks already wired in settings.local.json (no change)")

    # Migrate: an earlier init wrote these hooks to the shared settings.json. Pull them out so
    # they live only in the personal local file (and don't double-fire from both).
    shared = _load_settings(shared_path)
    if shared is None:
        _say(f"note: {shared_path} is not valid JSON; not migrating old hooks out of it")
    elif _remove_hook(shared, EVIDENCE_HOOK) | _remove_hook(shared, INTEGRITY_HOOK):
        shared_path.write_text(json.dumps(shared, indent=2) + "\n")
        _say("migrated Temper hooks out of the shared settings.json into settings.local.json")


def scaffold_temper(project: Path) -> None:
    base = project / ".temper"
    (base / "plans").mkdir(parents=True, exist_ok=True)
    progress = base / "progress.md"
    if not progress.exists():
        progress.write_text(
            "# Temper progress log\n\nNewest first. One entry per session: what you did, "
            "what you *verified* (receipt path), bugs found, next priority.\n")
    gi = base / ".gitignore"
    if not gi.exists():
        gi.write_text("# Never commit the receipt-signing key.\n.capture_key\n")
    _say("scaffolded .temper/ (plans/, progress.md, .gitignore)")


def ensure_config_block(project: Path) -> None:
    _cfg, err = claude_md.load_config(project)
    if err is None:
        _say("a ## Temper block already exists (CLAUDE.local.md or CLAUDE.md) — no change")
        return
    name, kind, baseline, verify, _notes = detect.detect(project)
    block = claude_md.render_block(detect.render(name, kind, baseline, verify))
    md = claude_md.write_target(project)  # always CLAUDE.local.md; never the shared CLAUDE.md
    existing = md.read_text() if md.exists() else ""
    md.write_text((existing.rstrip() + "\n\n" if existing.strip() else "") + block)
    _say(f"added ## Temper config block to {md.name} (kind={kind}, uncommitted) — review it / run /tp-init to refine")


def git_exclude(project: Path) -> None:
    info = project / ".git" / "info"
    if not info.parent.exists():
        return
    excl = info / "exclude"
    lines = excl.read_text().splitlines() if excl.exists() else []
    # Keep Temper's local footprint out of git: the ledger, the personal config file, and the
    # local settings file that carries the machine-specific hook paths.
    wanted = [".temper/", "CLAUDE.local.md", ".claude/settings.local.json"]
    missing = [w for w in wanted if w not in lines]
    if missing:
        info.mkdir(parents=True, exist_ok=True)
        with open(excl, "a") as f:
            f.write("\n# Temper (local; never committed)\n" + "\n".join(missing) + "\n")
        _say(f"excluded {', '.join(missing)} from git (.git/info/exclude)")


# Git hooks Temper owns. commit-msg strips Claude attribution; post-commit seals
# proven-and-committed claims so the standing audit treats them as historical (see
# scripts/git-hooks/ and hooks/seal.py).
GIT_HOOKS = ("commit-msg", "post-commit")


def install_git_hooks(project: Path) -> None:
    """Symlink Temper's git hooks into .git/hooks, never clobbering a user's own hook."""
    git_dir = project / ".git"
    if not git_dir.is_dir():  # not a plain git repo (bare/worktree/none) — skip quietly
        return
    hooks_dir = git_dir / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)
    for name in GIT_HOOKS:
        src, dst = TEMPER_ROOT / "scripts" / "git-hooks" / name, hooks_dir / name
        if dst.is_symlink():
            if dst.resolve() == src.resolve():
                continue
            dst.unlink()
            dst.symlink_to(src)
            _say(f"relinked git {name} hook -> {src}")
        elif dst.exists():
            _say(f"WARNING: existing .git/hooks/{name} left untouched — chain {src} into it manually")
        else:
            dst.symlink_to(src)
            _say(f"installed git {name} hook -> {src}")


def bootstrap(project: Path) -> int:
    if not project.is_dir():
        print(f"error: {project} is not a directory")
        return 1
    print(f"Initializing Temper in {project}")
    for cmd in sorted((TEMPER_ROOT / "commands").glob("tp-*.md")):
        _link(cmd, project / ".claude" / "commands" / cmd.name)
    for skill in ("temper", "temper-review"):
        _link(TEMPER_ROOT / "skills" / skill, project / ".claude" / "skills" / skill)
    wire_hooks(project)
    install_git_hooks(project)
    scaffold_temper(project)
    ensure_config_block(project)
    git_exclude(project)
    print("Done. Run /tp-init to refine the config, then /tp-plan and /tp-impl.")
    return 0


def dry_run(project: Path) -> int:
    subprocess.run([sys.executable, str(TEMPER_ROOT / "lib" / "detect.py"), str(project)])
    return 0


def capture(rest: list[str]) -> int:
    """Pass through to hooks/capture.py, preserving its real exit code (the anti-bluff core)."""
    p = subprocess.run([sys.executable, str(TEMPER_ROOT / "hooks" / "capture.py"), *rest])
    return p.returncode


def review_capture(rest: list[str]) -> int:
    """Pass through to hooks/review_capture.py, preserving its real exit code (0 pass / 1 block)."""
    p = subprocess.run([sys.executable, str(TEMPER_ROOT / "hooks" / "review_capture.py"), *rest])
    return p.returncode


HELP = """temper — bootstrap the anti-bluffing harness in a repo.

USAGE
  temper init [project] [--dry-run]
  temper capture --task ID [--claim "..."] [--kind baseline|verify] -- CMD...
  temper review-capture --in verdict.json   (or pipe verdict JSON on stdin)
  temper [-h | --help]

COMMANDS
  init [project]   Wire a repo for Temper: link the /tp-* slash commands and the temper +
                   temper-review skills, wire the evidence_gate (PreToolUse) and session_integrity
                   (Stop) hooks into .claude/settings.local.json (personal, gitignored — never the
                   shared settings.json), install the commit-msg + post-commit git hooks (existing
                   hooks are left untouched), scaffold .temper/, and write an auto-detected
                   `## Temper` config block to CLAUDE.local.md (never the shared CLAUDE.md).
                   Idempotent. `project` defaults to the current directory.
  capture          Run a command and record a signed COMMAND receipt for a task. Exits with
                   the command's own code — the only sanctioned way to prove the checks pass.
  review-capture   Sign a code-review verdict into a tree-pinned REVIEW receipt. A task needs
                   BOTH a green command receipt and a verdict=pass review receipt (same tree)
                   before it can be marked passing. Exits 0 on pass, 1 on block.

OPTIONS
  --dry-run        With init: only detect verify commands and print the `## Temper` block —
                   make no changes.
  -h, --help       Show this help and exit.

EXAMPLES
  temper init                          # bootstrap the current repo
  temper init ~/code/my-service        # bootstrap a specific repo
  temper init --dry-run                # preview the detected config, no wiring
  temper capture --task T1 -- make test            # earn a receipt for task T1

NOTES
  The engine lives in the temper repo and is referenced in place (nothing is installed
  system-wide); a remote engine updater (`temper sync`) is deferred. After init, drive work
  inside Claude Code with /tp-plan then /tp-impl (and /tp-review or /tp-swarm)."""


def main(argv: list[str]) -> int:
    flags = argv[1:]
    # `capture` passes everything through to capture.py verbatim (it has its own arg parser,
    # including a `--` separator and possibly -h inside CMD), so handle it before flag parsing.
    if flags and flags[0] == "capture":
        return capture(flags[1:])
    if flags and flags[0] == "review-capture":
        return review_capture(flags[1:])
    if any(a in ("-h", "--help", "help") for a in flags):
        print(HELP)
        return 0
    dry = "--dry-run" in flags
    positional = [a for a in flags if not a.startswith("-")]
    # `install` kept as a quiet alias for muscle memory; `init` is the documented verb.
    if not positional or positional[0] not in ("init", "install"):
        print(HELP, file=sys.stderr)
        return 2
    project = Path(positional[1]).resolve() if len(positional) > 1 else Path.cwd()
    return dry_run(project) if dry else bootstrap(project)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
